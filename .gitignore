# ==============================================================================
# Equi-Extin Master Root .gitignore
# Strictly excludes environment secrets, IDE configs, build caches, and local tracking
# ==============================================================================

# --- Environment Variables & Local Secrets ---
.env
.env.*
.env.local
.env.*.local
.env.development.local
.env.test.local
.env.production.local
*.env
!.env.example

# --- Operating System & Editor Files ---
.DS_Store
Thumbs.db
desktop.ini
.idea/
.vscode/
*.iml
*.iws
*.ipr
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
*.bak

# --- Build Artifacts & Dependencies ---
node_modules/
dist/
dist-ssr/
target/
build/
*.jar
*.war
*.class
.mvn/wrapper/maven-wrapper.jar

# --- Logs & Runtime Dumps ---
*.log
logs/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# --- Local Tracking & Ephemeral Developer Files ---
cookies.txt
[Qq]uestion*
QUESTION*
question/
*.local
