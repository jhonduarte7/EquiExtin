# ==============================================================================
# Equi-Extin Master Environment Variables Template (.env.example)
#
# Unified environment reference for root workspace, Docker Compose orchestration,
# and deployment environments uniting both decoupled services.
#
# DO NOT commit sensitive passwords or real keys to version control.
# ==============================================================================

# ==========================================
# 1. BACKEND SERVICE (Spring Boot & AI)
# ==========================================
SERVER_PORT=8090

# Database Credentials & Host
DB_HOST=localhost
DB_PORT=5433
DB_NAME=fire_safety_db
DB_USER=admin
DB_PASSWORD=your_secure_db_password_here

# Security / JWT Secret (HMAC-SHA512 hex key)
JWT_SECRET=404E635266556A586E3272357538782F413F4428472B4B6250645367566B5970
JWT_EXPIRATION_MS=86400000

# Ollama / Spring AI
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_CHAT_MODEL=llama3.1
OLLAMA_EMBEDDING_MODEL=all-minilm
AI_CHAT_TIMEOUT=120s

# ==========================================
# 2. FRONTEND SERVICE (React 19 + Vite)
# ==========================================
VITE_API_URL=http://localhost:8090/api
VITE_APP_NAME=Equi-Extin ERP
VITE_DEFAULT_LANGUAGE=es
